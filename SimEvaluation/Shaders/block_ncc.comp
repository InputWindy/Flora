	while(NCCResultPackedData[0].Lock2 == 1){}

	// lock
	atomicExchange(NCCResultPackedData[0].Lock2,1);

	NCCResultPackedData[0].I_2_Sum = NCCResultPackedData[0].I_2_Sum + data;

	// unlock
	atomicExchange(NCCResultPackedData[0].Lock2,0);
}

