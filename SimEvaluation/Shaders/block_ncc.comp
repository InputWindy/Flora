void AtomicAdd_T_Mul_I_Sum(vec4 data)
{
	// wait for thread lock 0
	while(NCCResultPackedData[0].Lock0 == 1){}

	// lock
	atomicExchange(NCCResultPackedData[0].Lock0,1);

	NCCResultPackedData[0].T_Mul_I_Sum = NCCResultPackedData[0].T_Mul_I_Sum + data;

	// unlock
	atomicExchange(NCCResultPackedData[0].Lock0,0);
}

void AtomicAdd_T_2_Sum(vec4 data)
{
	// wait for thread lock 0
	while(NCCResultPackedData[0].Lock1 == 1){}

	// lock
	atomicExchange(NCCResultPackedData[0].Lock1,1);

	NCCResultPackedData[0].T_2_Sum = NCCResultPackedData[0].T_2_Sum + data;

	// unlock
	atomicExchange(NCCResultPackedData[0].Lock1,0);
}

void AtomicAdd_I_2_Sum(vec4 data)
{
